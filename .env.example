# Copy this file to ".env" and fill in your values.
# .env is gitignored — never commit your real key.

# --- LLM provider: groq (default) | ollama | stub ---
#   groq  -> Groq free-tier cloud API (recommended; best quality, fast, $0)
#   ollama-> fully local via Ollama (http://localhost:11434/v1)
#   stub  -> no LLM at all; deterministic heuristics so the whole pipeline
#            runs offline with zero setup (use for a quick demo / CI)
LLM_PROVIDER=groq

# --- Groq settings (only used when LLM_PROVIDER=groq) ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
# Verify current model IDs in the Groq console — these can change.
LLM_MODEL=llama-3.3-70b-versatile
LLM_SMALL_MODEL=llama-3.1-8b-instant

# --- Generic endpoint override (lets you point at Ollama or any OpenAI-compatible API) ---
# For Ollama: LLM_BASE_URL=http://localhost:11434/v1  and LLM_MODEL=llama3.1:8b
LLM_BASE_URL=https://api.groq.com/openai/v1

# --- Embeddings (local) ---
# Set to "hashing" to force the dependency-free fallback embedder.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# --- Operations (optional) ---
# Where learned state is written; default is ./stores next to the code.
# STORES_DIR=/var/lib/reasoning-engine
# Release identification shown in the dashboard, health check and logs (set by the image build).
# APP_VERSION=dev
# GIT_SHA=unknown
# Logging: text (default, local) or json (one event per line; default in the container image).
# LOG_FORMAT=text
# LOG_LEVEL=INFO
