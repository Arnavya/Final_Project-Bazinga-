# Keep the build context small and free of secrets. Allow-list style: ignore everything,
# then re-include only what the Dockerfile copies.
*
!Dockerfile
!requirements-runtime.txt
!app.py
!pipeline.py
!run_all.py
!run_scenario.py
!engine/
!ingest/
!data/
!docker/entrypoint.sh
!.streamlit/config.toml

# Never send these even if a pattern above re-includes their parent.
**/__pycache__
**/*.pyc
**/.env
**/*.env
